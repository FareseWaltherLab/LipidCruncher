# macOS system files
.DS_Store

# Python cache and packaging
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Virtual environment
lipidcruncher_env*/

# Environment variables (secrets)
.env
.streamlit/secrets.toml
src/.streamlit/secrets.toml

# Streamlit secrets (config.toml is safe to track; secrets.toml is not)
.streamlit/secrets.toml
src/.streamlit/

# Claude Code local state (machine-specific, not shareable)
.claude/

# Temporary files and logs
*.tmp
*.swp
*.log

# Data CSV files (sample_datasets/ and test fixtures are already tracked and unaffected)
*.csv
!tests/fixtures/*.csv

# Documentation working files
*.docx
*.doc
docs/isotope_tracing_plan.md

# AI Studio interaction logs pulled from CloudWatch (local analysis only)
ai_studio_logs.jsonl
*.jsonl
docs/ai_studio_feedback.md
docs/integration_deployment.md
review_feedback.command

# IDE/editor config
.idea/
.vscode/

# Testing
.coverage
htmlcov/
.pytest_cache/


# Project-specific
LipidCruncher/*.json

# Ad-hoc datasets, vendor PDFs and other one-off material (see local/README.md)
local/

# Project development notes
PROJECT_KNOWLEDGE.md
paper_review_plan.md
AI_CHAT_LAYER_PLAN.md
AI_STUDIO_TOOL_USE_PLAN.md
AI_STUDIO_IMPROVEMENT_PLAN.md
AI_STUDIO_EVAL_PLAN.md

# AI Studio schematics (working files)
ai_studio_schematic.png
ai_studio_schematic.tiff

# Data/report files — keep stray CSV/PDF out of VCS.
# Sample datasets, test fixtures and bundled UI assets are whitelisted below.
*.csv
*.pdf
!sample_datasets/*.csv
!tests/fixtures/*.csv
!src/images/*.pdf
